{
	"name": "rater",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"check:ci": "biome ci --error-on-warnings",
		"check:fix": "biome check --write --unsafe",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:diff": "supabase db diff -f",
		"db:up": "supabase migration up",
		"db:new": "supabase migration new",
		"db:types": "supabase gen types --local --schema public > src/lib/supabase/database.types.ts",
		"db:seed": "node --env-file=.env.development --env-file=.env.local scripts/seed-movies.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.3",
		"@t3-oss/env-nextjs": "^0.13.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.31.0",
		"next": "^16.3.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"server-only": "^0.0.1",
		"shadcn": "^4.18.0",
		"tailwind-merge": "^3.6.0",
		"ts-extras": "^1.3.0",
		"tw-animate-css": "^1.4.0",
		"type-fest": "^5.8.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"supabase": "^2.114.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2"
	}
}
