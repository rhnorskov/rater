{
	"name": "rater",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"check:ci": "biome ci --error-on-warnings",
		"check:fix": "biome check --write --unsafe",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:diff": "supabase db diff -f",
		"db:up": "supabase migration up",
		"db:new": "supabase migration new",
		"db:types": "supabase gen types --local --schema public > src/lib/supabase/database.types.ts"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.111.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"next": "16.2.12",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"server-only": "^0.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"supabase": "^2.110.0",
		"tailwindcss": "^4",
		"typescript": "^7"
	}
}
