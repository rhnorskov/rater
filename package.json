{
	"name": "rater",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.1.2",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"check": "biome check",
		"check:ci": "biome ci --error-on-warnings",
		"check:fix": "biome check --write --unsafe",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:new": "supabase migration new",
		"db:types": "supabase gen types --local --schema public > src/lib/supabase/database.types.ts"
	},
	"dependencies": {
		"next": "16.2.12",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"supabase": "^2.109.1",
		"tailwindcss": "^4",
		"typescript": "^7"
	}
}
